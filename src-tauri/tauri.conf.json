{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DramaCraft",
  "version": "0.1.13",
  "identifier": "io.dramacraft.desktop",
  "build": {
    "beforeDevCommand": "npm run ffmpeg:download && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ffmpeg:download && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DramaCraft · 剧匠",
        "width": 1500,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DramaCraft",
    "shortDescription": "本地短剧工作台",
    "longDescription": "在本地项目里编写剧本、整理分镜并生成视频。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    },
    "resources": { "../resources/voices/": "voices/" },
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
